# Copy this file to .env at the project root and fill in your credentials.
# Run Spring Boot with the project root as the working directory.
# Use plain KEY=value entries without quotes or export (Java properties format).

APP_NAME=w_3d_world
SERVER_PORT=8080

# Supabase Dashboard > Connect > Session pooler (port 5432).
DB_URL=jdbc:postgresql://aws-0-ap-southeast-2.pooler.supabase.com:5432/postgres?sslmode=require
DB_USERNAME=postgres.YOUR_PROJECT_REF
DB_PASSWORD=YOUR_DATABASE_PASSWORD
DB_POOL_MAX_SIZE=5
DB_POOL_MIN_IDLE=1

JPA_SHOW_SQL=false
# Schema is managed manually in Supabase for this project.
FLYWAY_ENABLED=false


# Generate JWT_SECRET_KEY: openssl rand -base64 32
JWT_SECRET_KEY=REPLACE_WITH_BASE64_32_BYTE_RANDOM_KEY
# JWT expiration in milliseconds (30 minutes)
JWT_EXPIRATION=1800000

# Gmail SMTP sender
MAIL_FROM=your-sender@gmail.com
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-sender@gmail.com
MAIL_PASSWORD=YOUR_GOOGLE_APP_PASSWORD

# Email verification/reset links (local backend).
APP_BASE_URL=http://localhost:8080

# Cloudinary server-side credentials (never commit actual secrets).
CLOUDINARY_CLOUD_NAME=dbuzojydp
CLOUDINARY_API_KEY=YOUR_CLOUDINARY_API_KEY
CLOUDINARY_API_SECRET=YOUR_CLOUDINARY_API_SECRET
EMAIL_TOKEN_EXPIRATION=1800000

# ZaloPay sandbox. Keep real keys only in local .env or deployment secrets.
ZALOPAY_APP_ID=your_app_id
ZALOPAY_KEY1=your_key1
ZALOPAY_KEY2=your_key2
ZALOPAY_CREATE_URL=https://sb-openapi.zalopay.vn/v2/create
ZALOPAY_QUERY_URL=https://sb-openapi.zalopay.vn/v2/query
ZALOPAY_REFUND_URL=https://sb-openapi.zalopay.vn/v2/refund
ZALOPAY_CALLBACK_URL=

# Auth email retries persist on users.email_delivery_state (no outbox table).
AUTH_EMAIL_WORKER_ENABLED=true
AUTH_EMAIL_POLL_MS=2000
AUTH_EMAIL_MAX_ATTEMPTS=5
AUTH_EMAIL_RESEND_COOLDOWN_SECONDS=60

# Positive whole VND amount for one calendar month of storefront rental.
STOREFRONT_MONTHLY_FEE=99000

# Browser return URL; backend verifies payment using the ZaloPay query API.
ZALOPAY_REDIRECT_URL=http://localhost:5173/payment-result

# GHTK shipping quotes. Each seller uses their default address as pickup location.
GHTK_ENABLED=false
GHTK_TOKEN=
GHTK_BASE_URL=https://services.giaohangtietkiem.vn
GHTK_PARTNER_CODE=
GHTK_TRANSPORT=road
GHTK_PADDING_CM=2
GHTK_QUOTE_TTL_SECONDS=300

# Maximum time for a seller to accept a COD order (minutes).
ORDER_COD_ACCEPTANCE_TTL_MINUTES=1440
